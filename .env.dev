# Development port rebasing for local compose-backed dependencies
# Change TRACO_BASE_PORT to shift the whole block if you hit port collisions.
TRACO_BASE_PORT=12222

# Individual service ports (defaults derived from TRACO_BASE_PORT)
# Edit these directly if you prefer explicit ports.
SOCIETY_PORT=12222
LIVEKIT_PORT=12223
TRANSCRIBER_PORT=12224

# Hub instances (use these when running containerized hub nodes)
HUB1_PORT=12240
HUB2_PORT=12241
HUB3_PORT=12242

# Shared secrets for local dev
TRANSCRIBER_SHARED_SECRET=test-secret
TRACOHUB_WORKER_SECRET=
